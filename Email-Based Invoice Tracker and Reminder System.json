{
  "name": "Email-Based Invoice Tracker and Reminder System",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            { "mode": "everyMinute" }
          ]
        },
        "filters": {
          "labelIds": ["SENT"],
          "q": "subject:(invoice OR payment)"
        }
      },
      "name": "Sent Emails Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [100, 300],
      "credentials": {}
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "Direction", "value": "OUTGOING", "type": "string" },
            { "name": "EMAIL", "value": "={{ $json.to }}", "type": "string" },
            { "name": "Subject", "value": "={{ $json.subject }}", "type": "string" },
            { "name": "STATUS", "value": "Pending", "type": "string" },
            { "name": "DATE", "value": "={{ $json.date }}", "type": "string" },
            { "name": "AMOUNT", "value": "0", "type": "string" },
            { "name": "DueDate", "value": "", "type": "string" }
          ]
        }
      },
      "name": "Extract Sent Email Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [320, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": "",
        "sheetName": "Sheet1",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "DATE": "={{$json.DATE}}",
            "TYPE": "sent",
            "EMAIL": "={{$json.EMAIL}}",
            "AMOUNT": "={{$json.AMOUNT}}",
            "DueDate": "={{$json.DueDate}}",
            "STATUS": "={{$json.STATUS}}"
          }
        }
      },
      "name": "Save Sent to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [540, 300],
      "credentials": {}
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            { "mode": "everyMinute" }
          ]
        },
        "filters": {
          "labelIds": ["INBOX"],
          "q": "subject:(invoice OR payment)",
          "readStatus": "unread"
        }
      },
      "name": "Incoming Emails Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [100, 520],
      "credentials": {}
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "Direction", "value": "INCOMING", "type": "string" },
            { "name": "EMAIL", "value": "={{ $json.from }}", "type": "string" },
            { "name": "Subject", "value": "={{ $json.subject }}", "type": "string" },
            { "name": "STATUS", "value": "Pending", "type": "string" },
            { "name": "DATE", "value": "={{ $json.date }}", "type": "string" },
            { "name": "AMOUNT", "value": "0", "type": "string" },
            { "name": "DueDate", "value": "", "type": "string" }
          ]
        }
      },
      "name": "Extract Incoming Email Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [320, 520]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": "",
        "sheetName": "Sheet1",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "DATE": "={{$json.DATE}}",
            "TYPE": "received",
            "EMAIL": "={{$json.EMAIL}}",
            "AMOUNT": "={{$json.AMOUNT}}",
            "DueDate": "={{$json.DueDate}}",
            "STATUS": "={{$json.STATUS}}"
          }
        }
      },
      "name": "Save Incoming to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [540, 520],
      "credentials": {}
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            { "triggerAtHour": 9 }
          ]
        }
      },
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [100, 820]
    },
    {
      "parameters": {
        "documentId": "",
        "sheetName": "Sheet1"
      },
      "name": "Read Invoices",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [320, 820],
      "credentials": {}
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{$json.STATUS}}",
              "rightValue": "Pending",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "name": "Filter Pending",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [540, 820]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.Direction }}",
                    "rightValue": "OUTGOING",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.Direction }}",
                    "rightValue": "INCOMING",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "name": "Route by Direction",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [760, 820]
    },
    {
      "parameters": {
        "sendTo": "client@example.com",
        "subject": "Reminder: Pending Invoice",
        "message": "This is a reminder for your pending invoice."
      },
      "name": "Send Reminder to Client",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1000, 740],
      "credentials": {}
    },
    {
      "parameters": {
        "sendTo": "your-email@example.com",
        "subject": "Invoice Reminder Sent",
        "message": "Reminder sent to client."
      },
      "name": "Notify Me (Client)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1220, 740],
      "credentials": {}
    },
    {
      "parameters": {
        "sendTo": "your-email@example.com",
        "subject": "Pending Invoice Alert",
        "message": "You have a pending invoice."
      },
      "name": "Send Reminder to Me",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1000, 920],
      "credentials": {}
    },
    {
      "parameters": {
        "sendTo": "your-email@example.com",
        "subject": "Self Reminder Sent",
        "message": "Reminder sent to you."
      },
      "name": "Notify Me (Self)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1220, 920],
      "credentials": {}
    }
  ],
  "connections": {
    "Sent Emails Trigger": {
      "main": [[{ "node": "Extract Sent Email Data", "type": "main" }]]
    },
    "Extract Sent Email Data": {
      "main": [[{ "node": "Save Sent to Google Sheets", "type": "main" }]]
    },
    "Incoming Emails Trigger": {
      "main": [[{ "node": "Extract Incoming Email Data", "type": "main" }]]
    },
    "Extract Incoming Email Data": {
      "main": [[{ "node": "Save Incoming to Google Sheets", "type": "main" }]]
    },
    "Daily Schedule": {
      "main": [[{ "node": "Read Invoices", "type": "main" }]]
    },
    "Read Invoices": {
      "main": [[{ "node": "Filter Pending", "type": "main" }]]
    },
    "Filter Pending": {
      "main": [[{ "node": "Route by Direction", "type": "main" }]]
    },
    "Route by Direction": {
      "main": [
        [{ "node": "Send Reminder to Client", "type": "main" }],
        [{ "node": "Send Reminder to Me", "type": "main" }]
      ]
    },
    "Send Reminder to Client": {
      "main": [[{ "node": "Notify Me (Client)", "type": "main" }]]
    },
    "Send Reminder to Me": {
      "main": [[{ "node": "Notify Me (Self)", "type": "main" }]]
    }
  }
}
